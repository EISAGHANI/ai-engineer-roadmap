# Public URL of the deployed site (used for canonical URLs and Open Graph)
NEXT_PUBLIC_SITE_URL=https://ai-engineer-roadmap.vercel.app

# GitHub owner whose repositories are shown on the Projects pages
NEXT_PUBLIC_GITHUB_OWNER=EISAGHANI

# Neon Postgres (progress, accounts, topic quizzes). the topic quizzes are seeded automatically
# the first time a quiz loads (during the build on Vercel).
# DATABASE_URL=postgres://...

# Optional: a read-only GitHub token raises the API limit from 60 to 5000 requests/hour
# GITHUB_TOKEN=
